---
import { img, url, Button, EditUrlPill } from "webto/variant";

interface Props {
  /** The H1, ≤8 words. @example Dibuat untuk dipegang */
  headline?: string;
  /** One sentence under the headline, ≤20 words. @example Cangkir keramik buatan tangan, dibakar dua kali. */
  subheadline?: string;
  /** [0] the main photo or Blender render; [1] optional: its depth map from Blender (white = near, black = far, same size and framing). Without [1] the subject is assumed centred. @example [{"url":"/r2/s/render.webp"},{"url":"/r2/s/depth.webp"}] */
  images?: Array<{ url: string; alt?: string }>;
  /** Fallback photo carried over from another hero design; used when images is empty. @example /r2/s/produk.jpg */
  imageUrl?: string;
  ctaText?: string;
  ctaUrl?: string;
}

const { headline, subheadline, images = [], imageUrl = "", ctaText = "Pesan", ctaUrl = "#" } = Astro.props;
const color = img(images[0]?.url || imageUrl, 1600);
const depth = images[1]?.url ? img(images[1].url, 1600) : "";
---
<section class="relative isolate flex min-h-[85vh] items-end overflow-hidden bg-foreground text-background">
  {color ? (
    <img data-gl-poster src={color} crossorigin="anonymous" alt={images[0]?.alt ?? ""} data-edit-image="images.0.url" class="absolute inset-0 -z-20 h-full w-full object-cover" />
  ) : (
    <div data-edit-image="images.0.url" class="absolute inset-0 -z-20 bg-muted"></div>
  )}
  {depth && <img data-gl-depth src={depth} crossorigin="anonymous" alt="" data-edit-image="images.1.url" class="hidden" />}
  <div data-gl class="absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-foreground/80 via-foreground/20 to-transparent" aria-hidden="true"></div>
  <div class="mx-auto w-full max-w-6xl px-6 pb-16 sm:pb-24">
    <h1 class="max-w-3xl font-bold tracking-tight" data-edit-field="headline">{headline}</h1>
    {subheadline && <p data-edit-field="subheadline" class="mt-5 max-w-xl text-lg opacity-90">{subheadline}</p>}
    {ctaText && (
      <Button href={url(ctaUrl)} size="lg" class="relative mt-8">
        <span data-edit-field="ctaText">{ctaText}</span>
        <EditUrlPill field="ctaUrl" value={ctaUrl} />
      </Button>
    )}
  </div>
</section>

<script is:inline data-uses="ogl">
  if (!OGL) return;
  if (root.dataset.wvInit) return;
  root.dataset.wvInit = "1";
  const colorImg = root.querySelector("[data-gl-poster]");
  const depthImg = root.querySelector("[data-gl-depth]");
  const host = root.querySelector("[data-gl]");
  if (!colorImg || !host) return;
  const { Renderer, Program, Mesh, Triangle, Texture, Vec2 } = OGL;
  const renderer = new Renderer({ dpr: window.devicePixelRatio, alpha: true });
  const gl = renderer.gl;
  gl.canvas.style.width = "100%";
  gl.canvas.style.height = "100%";
  const tColor = new Texture(gl, { generateMipmaps: false });
  const tDepth = new Texture(gl, { generateMipmaps: false });
  const mouse = new Vec2(0, 0);
  const target = new Vec2(0, 0);
  const cover = new Vec2(1, 1);
  const program = new Program(gl, {
    vertex: `attribute vec2 uv; attribute vec2 position; varying vec2 vUv; void main() { vUv = uv; gl_Position = vec4(position, 0.0, 1.0); }`,
    fragment: `precision highp float;
      uniform sampler2D tColor; uniform sampler2D tDepth; uniform float uHasDepth;
      uniform vec2 uMouse; uniform vec2 uCover; uniform float uTime; varying vec2 vUv;
      void main() {
        vec2 uv = (vUv - 0.5) * uCover + 0.5;
        float d = uHasDepth > 0.5 ? texture2D(tDepth, uv).r : smoothstep(0.75, 0.0, distance(uv, vec2(0.5, 0.55)));
        vec2 drift = vec2(sin(uTime * 0.5), cos(uTime * 0.4)) * 0.35;
        vec2 shift = (uMouse + drift) * (d - 0.35) * 0.045;
        gl_FragColor = texture2D(tColor, clamp(uv + shift, 0.0, 1.0));
      }`,
    uniforms: { tColor: { value: tColor }, tDepth: { value: tDepth }, uHasDepth: { value: depthImg ? 1 : 0 }, uMouse: { value: mouse }, uCover: { value: cover }, uTime: { value: 0 } },
  });
  const mesh = new Mesh(gl, { geometry: new Triangle(gl), program });
  const fit = () => {
    renderer.setSize(root.clientWidth, root.clientHeight);
    const box = root.clientWidth / root.clientHeight;
    const pic = colorImg.naturalWidth / colorImg.naturalHeight;
    cover.x = box < pic ? box / pic : 1;
    cover.y = box < pic ? 1 : pic / box;
  };
  const ready = (im) => !im || (im.complete && im.naturalWidth);
  let started = false;
  function start() {
    if (started || !ready(colorImg) || !ready(depthImg)) return;
    started = true;
    tColor.image = colorImg;
    if (depthImg) tDepth.image = depthImg;
    host.appendChild(gl.canvas);
    fit();
    new ResizeObserver(fit).observe(root);
    root.addEventListener("pointermove", (e) => {
      const r = root.getBoundingClientRect();
      target.x = ((e.clientX - r.x) / r.width) * 2 - 1;
      target.y = ((e.clientY - r.y) / r.height) * 2 - 1;
    });
    function frame(t) {
      requestAnimationFrame(frame);
      mouse.x += (target.x - mouse.x) * 0.06;
      mouse.y += (target.y - mouse.y) * 0.06;
      program.uniforms.uTime.value = t * 0.001;
      renderer.render({ scene: mesh });
    }
    requestAnimationFrame(frame);
  }
  [colorImg, depthImg].forEach((im) => { if (im && !ready(im)) im.addEventListener("load", start, { once: true }); });
  start();
</script>
