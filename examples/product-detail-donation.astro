---
import { Container, ProductBuyBox, ProductGallery, ProductDescription, ProductAttributes } from "webto/variant";

interface Props {
  /** Eyebrow over the campaign title, a few words. @example Program donasi */
  eyebrow?: string;
  /** Text after the amount raised in the progress line. @example terkumpul dari target */
  raisedCaption?: string;
  /** Title over the campaign story. @example Cerita program ini */
  storyTitle?: string;
  product?: { id: string; name: string; kind: string };
  view?: {
    name: string;
    kind: string;
    kindInfo: { kind: string; percent?: number | null; raisedLabel?: string | null; targetLabel?: string | null };
  };
  linkPrefix?: string;
}

const { eyebrow = "Program donasi", raisedCaption = "terkumpul dari target", storyTitle = "Cerita program ini", view } = Astro.props;
const info = view.kindInfo;
const showProgress = info.kind === "donation" && info.percent !== null && info.percent !== undefined;
---
<section class="bg-background py-12 md:py-20 text-foreground">
  <Container>
    <div class="grid grid-cols-1 gap-10 md:grid-cols-5 md:gap-14">
      <ProductGallery aspect="wide" class="md:col-span-3" />
      <div class="md:col-span-2">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary">{eyebrow}</p>
        <h1 class="mt-3 !text-3xl font-bold" style="font-family: var(--font-heading);">{view.name}</h1>
        {showProgress && (
          <div class="mt-6">
            <div class="h-2 w-full overflow-hidden rounded-full bg-muted">
              <div class="h-full rounded-full bg-primary" style={`width: ${info.percent}%`}></div>
            </div>
            <p class="mt-2 text-sm text-muted-foreground">
              <strong class="text-foreground">{info.raisedLabel}</strong> {raisedCaption} {info.targetLabel}
            </p>
          </div>
        )}
        <ProductBuyBox class="mt-6" />
      </div>
    </div>
    <div class="mx-auto mt-16 max-w-3xl">
      <h2 class="!text-2xl font-bold" style="font-family: var(--font-heading);">{storyTitle}</h2>
      <ProductDescription size="lg" class="mt-6" />
      <ProductAttributes class="mt-10" />
    </div>
  </Container>
</section>
