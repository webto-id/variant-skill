---
import { img, Container, AddImageButton } from "webto/variant";

interface Props {
  heading?: string;
  subheading?: string;
  images?: Array<{ url: string; alt?: string; caption?: string }>;
}

const { heading = "Galeri", subheading = "", images = [] } = Astro.props;
---
<section class="py-20 sm:py-28 bg-background text-foreground">
  <Container>
    <h2 class="font-bold tracking-tight mb-12"><span data-edit-field="heading">{heading}</span></h2>
    {subheading && <p data-edit-field="subheading" class="-mt-8 mb-12 text-lg text-muted-foreground">{subheading}</p>}
    <div data-lightbox-group class="grid gap-6 sm:grid-cols-2">
      {images.map((im, i) => (
        <figure data-reveal class="overflow-hidden rounded-xl">
          <img src={img(im.url, 1000)} data-lightbox data-lightbox-src={img(im.url, 1800)} data-edit-image={`images.${i}.url`} alt={im.alt ?? ""} loading="lazy" class="w-full aspect-[4/5] object-cover" />
        </figure>
      ))}
    </div>
    <AddImageButton path={`images.${images.length}.url`} visible={images.length < 20} />
  </Container>
</section>

<script is:inline data-uses="gsap scroll-trigger">
  gsap.context(() => {
    root.querySelectorAll("[data-reveal]").forEach((fig) => {
      const tl = gsap.timeline({ scrollTrigger: { trigger: fig, start: "top 85%", once: true } });
      tl.fromTo(fig, { clipPath: "inset(100% 0% 0% 0%)" }, { clipPath: "inset(0% 0% 0% 0%)", duration: 1.1, ease: "power4.inOut" })
        .fromTo(fig.querySelector("img"), { scale: 1.3 }, { scale: 1, duration: 1.4, ease: "power3.out" }, 0);
    });
  }, root);
</script>
